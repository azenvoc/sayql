{
  "name": "sayql",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "oxlint --quiet src && node scripts/check-tokens.mjs && node scripts/check-architecture.mjs",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:types": "cd src-tauri && cargo test --lib write_typescript_bindings -- --ignored",
    "test": "vitest run && cd src-tauri && cargo test --lib",
    "check": "pnpm format:check && pnpm lint && pnpm build && cd src-tauri && cargo fmt --check && cd .. && pnpm lint:ratchet && pnpm test",
    "hooks": "git config core.hooksPath .githooks",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "1.59.0",
    "monaco-editor": "0.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.1.0",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.0.16",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17"
    }
  }
}
