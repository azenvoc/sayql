{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-danger": "error",
    "import/no-cycle": "error",
    "no-unused-vars": "error",
    "no-console": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    // `typeof import("…")` stays allowed: it is how vitest types a module it mocks.
    "typescript/consistent-type-imports": ["error", { "disallowTypeAnnotations": false }],
    // A warning: the existing ones are counted in lint-baseline.json, and the count may only go
    // down (scripts/lint-ratchet.mjs). New code narrows with a check instead of `!`.
    "typescript/no-non-null-assertion": "warn",
    // `x == null` (null or undefined) is the one loose comparison allowed.
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    // TypeScript already checks imports; this rule can't see Vite's `?worker` modules.
    "import/default": "off",

    // React Compiler rules: SayQL doesn't use the compiler, so these are advice, not bugs.
    "react/set-state-in-effect": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/preserve-manual-memoization": "off",
    "react/incompatible-library": "off",
    "react/globals": "off"
  },
  "ignorePatterns": [
    "dist",
    "src-tauri",
    "site",
    "node_modules",
    // Generated from the Rust types by `pnpm gen:types`.
    "src/api/bindings.ts"
  ]
}
